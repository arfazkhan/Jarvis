# ═══════════════════════════════════════════════════════════════════════════════
# ARVIS on-prem site — TLS front door (used by docker-compose.site.yml)
# ═══════════════════════════════════════════════════════════════════════════════
# The API itself listens on 127.0.0.1:8000 only. This proxy is the one way in,
# and it listens on the MANAGEMENT interface only (ARVIS_MGMT_IP) — never on the
# BMS network interface. The official nginx image fills ${ARVIS_MGMT_IP} from the
# environment at start-up; nginx's own $variables are left untouched.
#
# Certificates: ./nginx/ssl/cert.pem + key.pem (site CA or self-signed).
# ═══════════════════════════════════════════════════════════════════════════════

limit_req_zone $binary_remote_addr zone=arvis_api:10m  rate=10r/s;
limit_req_zone $binary_remote_addr zone=arvis_auth:10m rate=5r/m;

server_tokens off;

server {
    listen ${ARVIS_MGMT_IP}:80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen ${ARVIS_MGMT_IP}:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 10M;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Login: tight rate limit against password guessing
    location = /api/v1/auth/token {
        limit_req zone=arvis_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }

    # Live streams (Server-Sent Events): no buffering, long reads
    location ~ ^/(api/[^ ]*/)?stream/ {
        limit_req zone=arvis_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        limit_req zone=arvis_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_read_timeout 120s;
    }
}
