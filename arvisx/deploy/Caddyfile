# AllGud pilot — one origin: SPA + API behind auto-HTTPS.
# DOMAIN is injected from the environment (see docker-compose.pilot.yml).
{$DOMAIN} {
	encode gzip

	# API → the api container. Everything under /api/* (incl. the SSE stream).
	handle /api/* {
		reverse_proxy api:8090
	}

	# SPA → static files with client-side routing fallback, so deep links like
	# /field/run/42?t=... resolve to index.html and the router takes over.
	handle {
		root * /srv
		# Hashed assets are immutable; everything else (the HTML shell + SPA routes)
		# must revalidate so a new deploy is picked up without a hard refresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@doc not path /assets/*
		header @doc Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Operator admin panel — its own subdomain, serves admin.html (separate from the
# building console). Defaults to an internal .localhost name when ADMIN_DOMAIN is unset
# (local dev) so the block never breaks the config.
{$ADMIN_DOMAIN:admin.localhost} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8090
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@doc not path /assets/*
		header @doc Cache-Control "no-cache"
		try_files {path} /admin.html
		file_server
	}
}

# Local/staging without a real domain + cert: set DOMAIN=:80 in .env to serve
# plain HTTP on port 80 (note: clipboard "Field link" + camera need HTTPS, so use
# a real domain for the actual pilot).
