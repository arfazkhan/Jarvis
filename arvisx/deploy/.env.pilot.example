# AllGud One Anthem pilot — copy to `.env` in this directory and fill in.
# NEVER commit the filled .env (it holds secrets).  cp .env.pilot.example .env

# ── Public hostname ───────────────────────────────────────────────────────
# A DNS A-record for this must point at the VPS public IP. Ports 80+443 open.
# Caddy gets a Let's Encrypt cert for it automatically on first boot.
DOMAIN=oneanthem.example.com

# ── Image registry (cloud/registry-pull deploy only — see CLOUD_DEPLOY_DIGITALOCEAN.md) ──
# Used by docker-compose.cloud.yml. Ignore these for the local/build compose.
REGISTRY=ghcr.io/arfazkhan
TAG=latest

# ── Secrets — generate each with: openssl rand -hex 32 ────────────────────
ARVISX_API_KEY=
ARVISX_AUTH_SECRET=

# ── Owner login (bootstrapped on first boot if no users exist) ────────────
ARVISX_ADMIN_USER=athul
ARVISX_ADMIN_PASSWORD=

# ── Operator ADMIN panel login (admin.<DOMAIN>) — separate from the building owner ──
ARVISX_PANEL_USER=ops
ARVISX_PANEL_PASSWORD=

# ── Money framing (optional) ──────────────────────────────────────────────
ARVISX_TARIFF=0.11
ARVISX_CURRENCY=QAR

# ── LLM (optional). 0 = deterministic floor only (advisory text still works). ──
# Set 1 + a K2Think key to enable the LLM-on-floor layer (ask/rca/handover).
ARVIS_X_LLM=0
ARVISX_LLM_PROVIDER=k2think
K2THINK_API_KEY=

# ── WhatsApp bot ──────────────────────────────────────────────────────────
# Owner number (country code, no +). Gets the daily digest + critical alerts.
OWNER_NUMBER=974XXXXXXXX
SESSION_NAME=session
AUTH_REQUIRED=true
RESPONSE_IN_DMS=true
RESPONSE_IN_GROUPS=false
