# ════════════════════════════════════════════════════════════════════════
#  ArvisX API — pilot configuration. Copy to `.env` and fill in.
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════════════

# ── Security (REQUIRED for any networked pilot) ──────────────────────────
# Every /api/v1 call must present this as `X-API-Key:` or `Authorization: Bearer`.
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank the API runs OPEN (dev only) and logs a warning.
ARVISX_API_KEY=

# Comma-separated allowed CORS origins for a browser dashboard. Leave as * for
# dev; lock to your dashboard URL in production, e.g. https://ops.yourbuilding.com
ARVISX_CORS=*

# ── Frontend user auth (roles: owner / fm / viewer) ──────────────────────
# User login (POST /api/v1/auth/login → token) is enforced when any user exists
# OR ARVISX_API_KEY is set. Writes (non-GET) require owner/fm; viewer is read-only.
# Bootstrap the first owner account (created once if no users exist yet):
ARVISX_ADMIN_USER=
ARVISX_ADMIN_PASSWORD=
# Secret used to sign login tokens (HMAC). Falls back to ARVISX_API_KEY if unset.
# Set a strong, stable value in production:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ARVISX_AUTH_SECRET=
# Token lifetime in seconds (default 86400 = 24h).
ARVISX_TOKEN_TTL=86400

# ── Data source ──────────────────────────────────────────────────────────
# "mqtt" = live telemetry from the broker (pilot default, set in compose).
# "sim"  = built-in simulator (demo / no hardware).
ARVISX_SOURCE=mqtt
# Broker host/port are set by docker-compose (broker:1883). Override only if you
# point at an external broker:
# ARVISX_MQTT_BROKER=localhost
# ARVISX_MQTT_PORT=1883

# ── Economic layer (money framing) ───────────────────────────────────────
# Tariff = currency per kWh. Qatar (Kahramaa residential) ≈ 0.11 QAR/kWh.
# India example: ARVISX_TARIFF=8  ARVISX_CURRENCY=INR
ARVISX_TARIFF=0.11
ARVISX_CURRENCY=QAR

# ── LLM layer (commercial UnifiedLLM, vendored into the image) ───────────
# The deterministic floor always runs; the LLM only adds reasoning/ask/
# investigate/correlate on top (it proposes, the floor disposes — no hallucinated
# facts reach output). Set to 1 to enable. Requires `vendor_commercial.py` run
# before build AND at least one provider key below.
ARVIS_X_LLM=1

# ArvisX uses its OWN lightweight OpenAI-compatible client (arvisx/llm_client.py),
# NOT the commercial UnifiedLLM (whose vendored LLMAgent is a stub that only reaches
# Bedrock). Pick the provider — all are OpenAI-compatible, no boto3/Bedrock needed:
#   k2think (default) | groq | openai
ARVISX_LLM_PROVIDER=k2think

# Set the key for your chosen provider (the others can stay blank).
K2THINK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional per-provider overrides (sensible defaults otherwise):
# K2THINK_BASE_URL=https://api.k2think.ai/v1
# K2THINK_MODEL=MBZUAI-IFM/K2-Think-v2
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
#
# Advanced: ARVISX_LLM_PROVIDER=bedrock routes via the commercial UnifiedLLM
# (needs boto3 + AWS_BEARER_TOKEN_BEDROCK or AWS creds). Not needed for a pilot.

# ── Misc ─────────────────────────────────────────────────────────────────
ARVISX_API_PORT=8090
# ARVISX_DB is set to /data/arvisx.db by the container (persisted volume).
