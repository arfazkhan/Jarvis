# AllGud frontend config. Copy to .env (dev) or set at build time (prod).

# Backend API base. Dev default is http://localhost:8091/api/v1.
# Pilot: point at the deployed API over HTTPS.
VITE_API_BASE=http://localhost:8091/api/v1

# Optional server-to-server API key (NOT for real multi-user — use login instead).
# Leave blank for the pilot; users sign in via /auth/login.
VITE_API_KEY=
