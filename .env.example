# ═══════════════════════════════════════════════════════════════════════════════
# ARVIS Ops Copilot - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and configure for your environment
# All variables with "REQUIRED" must be set for production deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# CORE SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Environment mode: development, staging, production
ENV=development

# Enable debug mode (true/false) - DISABLE in production
DEBUG=true

# ═══════════════════════════════════════════════════════════════════════════════
# LLM PROVIDERS - At least one provider REQUIRED for production
# ═══════════════════════════════════════════════════════════════════════════════

# Groq API Key (PRIMARY - Fast inference) - REQUIRED for production
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Key (Alternative provider)
OPENAI_API_KEY=your-openai-api-key-here

# K2-Think API Configuration (Advanced reasoning)
K2THINK_API_KEY=your-k2think-api-key-here
K2THINK_BASE_URL=https://api.k2think.com/v1

# LM Studio (Local LLM - Development only)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OpenRouter (Multi-model gateway)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# TEXT-TO-SPEECH CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# TTS Engine: edgetts, vibevoice, cosyvoice, kokoro, coqui, piper
TTS_ENGINE=vibevoice

# Edge TTS Settings (Free, cloud-based)
EDGETTS_VOICE=guy
EDGETTS_RATE=+0%

# VibeVoice Settings (Local GPU)
VIBEVOICE_MODEL=microsoft/VibeVoice-Realtime-0.5B
VIBEVOICE_DEVICE=cuda
VIBEVOICE_SPEAKER=carter

# CosyVoice Settings (High-quality, low-latency)
COSYVOICE_MODEL=Fun-CosyVoice3-0.5B
COSYVOICE_DEVICE=cuda
COSYVOICE_SPEAKER=英文女

# ═══════════════════════════════════════════════════════════════════════════════
# WEB UI CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Secret key for session management - REQUIRED for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_UI_SECRET=CHANGE-THIS-IN-PRODUCTION

# API Server port
API_PORT=8000

# Enable CORS (true/false) - Enable only if needed
ENABLE_CORS=false

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# SQLite (Development)
DATABASE_URL=sqlite:///data/arvis.db

# PostgreSQL (Production) - REQUIRED for production
# DATABASE_URL=postgresql://user:password@localhost:5432/arvis

# Redis (Optional - for distributed caching)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (Vector storage)
CHROMA_PERSIST_DIR=data/chroma

# ═══════════════════════════════════════════════════════════════════════════════
# BACnet CONFIGURATION (Commercial Mode)
# ═══════════════════════════════════════════════════════════════════════════════

# BACnet device discovery
BACNET_DEVICE_ID=1234
BACNET_PORT=47808
BACNET_SUBNET=192.168.1.0/24

# OPC UA (ARVIS_MODE=opcua; endpoint + points go in the site BMS config under `opcua:`)
# Credentials only here, never in the config file. Use a read-only server account.
ARVIS_OPCUA_USERNAME=
ARVIS_OPCUA_PASSWORD=

# Field checks over WhatsApp via a self-hosted Evolution API (agent_commercial/messaging/evolution.py)
# Use the WHATSAPP-BUSINESS integration (official Cloud API) for customer sites.
ARVIS_EVOLUTION_URL=http://127.0.0.1:8080
ARVIS_EVOLUTION_INSTANCE=
ARVIS_EVOLUTION_APIKEY=
ARVIS_EVOLUTION_WEBHOOK_TOKEN=        # long random string; Evolution sends it back on every webhook
ARVIS_FIELD_TECHNICIANS=              # "Ali:+97455501234, Ravi:+97455505678"
ARVIS_FIELD_CHECK_TTL_H=12
ARVIS_FIELD_CHECK_MAX_CHAIN=4

# ARVIS on WhatsApp — the 24/7 operations engineer (agent_commercial/ops_engineer)
# Site roster: name:number:role (owner | fm | technician). Not on the roster = ignored.
ARVIS_PEOPLE=                         # "Sara:+97455501111:fm, Ali:+97455501234:technician, Omar:+97455509999:owner"
ARVIS_BUILDING_NAME=
ARVIS_TZ=Asia/Qatar
ARVIS_OPS_QUIET_HOURS=22-6            # confirmed faults wait for the morning brief
ARVIS_OPS_BRIEF_HOUR=7
ARVIS_OPS_OWNER_BRIEF_DAY=Sunday
ARVIS_OPS_OWNER_COST=1000             # owner hears about a fault only above this avoidable cost
ARVIS_OPS_MAX_PER_HOUR=4              # unprompted messages per person per hour

# ═══════════════════════════════════════════════════════════════════════════════
# MATTER/THREAD CONFIGURATION (Residential Mode)
# ═══════════════════════════════════════════════════════════════════════════════

# Matter controller settings
MATTER_VENDOR_ID=65521
MATTER_FABRIC_ID=1

# Thread network credentials
THREAD_NETWORK_NAME=ARVIS-Thread
THREAD_NETWORK_KEY=your-thread-network-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# API Key for external integrations
ARVIS_API_KEY=your-secure-api-key-here

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ═══════════════════════════════════════════════════════════════════════════════
# OBSERVABILITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Enable tracing (true/false)
ENABLE_TRACING=true

# ═══════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════════

# Enable predictive maintenance
ENABLE_PREDICTIVE_MAINTENANCE=true

# Enable energy optimization
ENABLE_ENERGY_OPTIMIZATION=true

# Enable GSAS advisory
ENABLE_GSAS_ADVISORY=true

# Enable fleet intelligence
ENABLE_FLEET_INTELLIGENCE=true

# ═══════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════════

# Enable mock BACnet devices
MOCK_BACNET_DEVICES=true

# Enable virtual sensors
ENABLE_VIRTUAL_SENSORS=true

# Skip authentication (DANGEROUS - Development only)
SKIP_AUTH=false

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT SECURITY
# ═══════════════════════════════════════════════════════════════════════════════
# docker-compose.yml refuses to start without these (there are no default passwords)
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=

# On-prem building site (docker-compose.site.yml)
# Management-network IP of the edge box — the only interface the TLS proxy listens on
ARVIS_MGMT_IP=
# Outbound allow list (ARVIS_EGRESS_POLICY=enforce is set by the site compose file).
# Hostnames, ".domain" suffixes or CIDRs. Empty = nothing leaves the site LAN.
# e.g. ARVIS_EGRESS_ALLOW=api.k2think.ai
ARVIS_EGRESS_ALLOW=
# API bind address. Site compose uses 127.0.0.1 (behind the proxy); default 0.0.0.0.
# ARVIS_API_HOST=127.0.0.1
